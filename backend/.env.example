# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or local fallback)
# If left empty in development, SafePath automatically runs an in-memory Mongo instance for seamless local testing.
MONGODB_URI=mongodb://localhost:27017/safepath
USE_MEMORY_DB=false

# Authentication Secrets
JWT_SECRET=safepath_super_secure_jwt_secret_change_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=safepath_secure_cookie_secret_min32chars

# Web Push API (VAPID Keys for browser push notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@safepath.app

# Real Notification Provider Adapters
# 1. Resend (Transactional emails for alert dispatch & contact invitations)
# Get key at: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=SafePath Alerts <alerts@safepath.app>

# 2. Twilio (Optional SMS alerts)
# Get credentials at: https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 3. OpenRouteService (Optional for turn-by-turn route geometry & driving/walking directions)
# Get key at: https://openrouteservice.org
OPENROUTESERVICE_API_KEY=

# 4. OpenAI (Optional: generates concise, objective 1-2 sentence emergency incident summaries for contacts)
# Never controls escalation or emergency decisions.
OPENAI_API_KEY=
